<!-- Wide Dubeolsik experiment: standard layout with only ㅐㅔ removed.
     Row 1 has 8 keys (ㅂㅈㄷㄱㅅㅛㅕㅑ, ㅐㅔ removed) at 12.5%p each = 100%.
     Rows 2-3 follow the standard layout exactly (11.1%p keys):
     row 2 ㅁㄴㅇㄹㅎㅗㅓㅏㅣ (9 keys), row 3 ㅋㅌㅊㅍㅠㅜㅡ (7 keys)
     with delete on the left and shift on the right of row 3. -->

<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Row
        latin:keyWidth="12.5%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift_wide1" />
    </Row>
    <Row
        latin:keyWidth="11.1%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift_wide2" />
    </Row>
    <Row
        latin:keyWidth="11.1%p"
    >
        <switch>
            <case
                latin:showBackspaceOnRight="true">
                <!-- Left side empty (spacer keeps ㅋ under ㄴ), backspace on the right -->
                <Spacer
                    latin:keyWidth="11.1%p" />
                <include
                    latin:keyXPos="11.1%p"
                    latin:keyboardLayout="@xml/rowkeys_noshift_wide3" />
                <Key
                    latin:keyStyle="deleteKeyStyle"
                    latin:keyXPos="88.8%p"
                    latin:keyWidth="11.2%p" />
            </case>
            <default>
                <!-- Backspace on the left, shift on the right -->
                <Key
                    latin:keyStyle="deleteKeyStyle"
                    latin:keyWidth="11.1%p" />
                <include
                    latin:keyXPos="11.1%p"
                    latin:keyboardLayout="@xml/rowkeys_noshift_wide3" />
                <Key
                    latin:keyStyle="shiftKeyStyle"
                    latin:keyXPos="88.8%p"
                    latin:keyWidth="11.2%p" />
            </default>
        </switch>
    </Row>
    <include
        latin:keyboardLayout="@xml/row_noshift_bottom" />
</merge>
