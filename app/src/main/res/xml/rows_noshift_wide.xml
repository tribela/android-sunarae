<!-- Wide Dubeolsik arrangement (ortholinear grid, no stagger):
     All rows use keyWidth="10%p" so columns align exactly:
     col  0  1  2  3  4  5  6  7  8
     row1 ㅂ ㅈ ㄷ ㄱ ㅅ ㅛ ㅕ ㅑ  _   (8 keys, ㅐㅔ removed)
     row2 ㅁ ㄴ ㅇ ㄹ ㅎ ㅗ ㅓ ㅏ  _   (8 keys, ㅣ moved to row 3)
     row3 ㅋ ㅌ ㅊ ㅍ ㅠ ㅜ ㅡ ㅣ ⌫   (8 keys + narrow delete)
     ㅣ sits directly below ㅏ; ㅋ aligns with ㅂ/ㅁ. -->

<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift_wide1" />
    </Row>
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift_wide2" />
    </Row>
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift_wide3" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="10%p" />
    </Row>
    <include
        latin:keyboardLayout="@xml/row_noshift_bottom" />
</merge>
