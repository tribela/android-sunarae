<!-- Dubeolsik row 2: ㅁㄴㅇㄹㅎㅗㅓㅏㅣ (9 keys).
     Compound vowels (ㅘㅙㅚㅝㅞㅟㅢ) are produced by the noshift combiner
     from vowel sequences, so no popups are needed here. -->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+3141: "ㅁ" -->
    <Key
        latin:keySpec="&#x3141;" />
    <!-- U+3134: "ㄴ" -->
    <Key
        latin:keySpec="&#x3134;" />
    <!-- U+3147: "ㅇ" -->
    <Key
        latin:keySpec="&#x3147;" />
    <!-- U+3139: "ㄹ" -->
    <Key
        latin:keySpec="&#x3139;" />
    <!-- U+314E: "ㅎ" -->
    <Key
        latin:keySpec="&#x314E;" />
    <!-- U+3157: "ㅗ" -->
    <Key
        latin:keySpec="&#x3157;" />
    <!-- U+3153: "ㅓ" -->
    <Key
        latin:keySpec="&#x3153;" />
    <!-- U+314F: "ㅏ" -->
    <Key
        latin:keySpec="&#x314F;" />
    <!-- U+3163: "ㅣ" -->
    <Key
        latin:keySpec="&#x3163;" />
</merge>
