<!-- Standard Dubeolsik 10-9-7 arrangement with physical-keyboard stagger:
     Row 1 uses 10 keys x 10%p = 100%. Rows 2 and 3 use 11.1%p keys so they
     also fill the screen edge to edge: row 2 is left-aligned (9 x 11.1 = 100%),
     row 3 starts at 11.1% so ㅋ sits under ㄴ (7 x 11.1 = 77.7%) and a narrow
     11.1%p delete key fills the right edge. The vowel keys (ㅛㅕㅑㅐㅔ,
     ㅗㅓㅏㅣ, ㅠㅜㅡ) stay under the right hand. No shift key (noshift rules). -->

<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift1" />
    </Row>
    <Row
        latin:keyWidth="11.1%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_noshift2" />
    </Row>
    <Row
        latin:keyWidth="11.1%p"
    >
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="11.1%p" />
        <include
            latin:keyXPos="11.1%p"
            latin:keyboardLayout="@xml/rowkeys_noshift3" />
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyXPos="88.8%p"
            latin:keyWidth="11.2%p" />
    </Row>
    <include
        latin:keyboardLayout="@xml/row_noshift_bottom" />
</merge>
