<!-- Dubeolsik row 3: ㅋㅌㅊㅍㅠㅜㅡ (7 keys).
     Long-press popups mirror the AOSP/Gboard English keyboard special
     characters on the physical QWERTY positions (Z->*, X->", C->', V->;,
     B->:, N->,, M->.). -->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+314B: "ㅋ" -> hint '"', popup '"' -->
    <Key
        latin:keySpec="&#x314B;"
        latin:keyHintLabel="&quot;"
        latin:moreKeys="&quot;" />
    <!-- U+314C: "ㅌ" -> hint "'", popup "'" -->
    <Key
        latin:keySpec="&#x314C;"
        latin:keyHintLabel="'"
        latin:moreKeys="'" />
    <!-- U+314A: "ㅊ" -> hint ":", popup ":", ";" (two candidates) -->
    <Key
        latin:keySpec="&#x314A;"
        latin:keyHintLabel=":"
        latin:moreKeys=":,;" />
    <!-- U+314D: "ㅍ" -> hint "/", popup "/", "|", "\" (\\ escaped backslash) -->
    <Key
        latin:keySpec="&#x314D;"
        latin:keyHintLabel="/"
        latin:moreKeys="/,|,\\" />
    <!-- U+3160: "ㅠ" -> hint "|", popup "|" -->
    <Key
        latin:keySpec="&#x3160;"
        latin:keyHintLabel="|"
        latin:moreKeys="|" />
    <!-- U+315C: "ㅜ" -> hint "!", popup "!" -->
    <Key
        latin:keySpec="&#x315C;"
        latin:keyHintLabel="!"
        latin:moreKeys="!" />
    <!-- U+3161: "ㅡ" -> hint "?", popup "?" (\? escaped, as in rkkr keys_exclamation_question.xml) -->
    <Key
        latin:keySpec="&#x3161;"
        latin:keyHintLabel="\?"
        latin:moreKeys="\?" />
</merge>
