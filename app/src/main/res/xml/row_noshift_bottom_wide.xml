<!-- Wide layout bottom row: the delete key lives between period and enter,
     so the 3rd jamo row can be a clean ortholinear 8-column grid without
     a delete key on the right. The space bar is narrowed and the language
     switch key kept so the enter key stays at a normal size. -->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Row
        latin:keyWidth="10%p"
    >
        <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="12%p" />
        <include
            latin:keyboardLayout="@xml/key_comma" />
        <Key
            latin:keyStyle="languageSwitchKeyStyle"
            latin:keyWidth="10%p" />
        <Key
            latin:keyStyle="spaceKeyStyle"
            latin:keyWidth="15%p" />
        <include
            latin:keyboardLayout="@xml/key_period" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="10%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
