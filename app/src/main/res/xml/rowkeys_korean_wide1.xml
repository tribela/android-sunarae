<!-- Wide layout row 1: ㅂㅈㄷㄱㅅㅛㅕㅑ (8 keys, ㅐㅔ removed).
     Long-press popups mirror the AOSP/Gboard English keyboard special
     characters on the physical QWERTY positions (Q->~, W->`, E->!,
     R->?, T->^, Y->{, U->}, I->[, O->]). ㅕ offers "(" and "[",
     ㅑ offers ")" and "]". -->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+3142: "ㅂ" -> hint "~", popup "~" -->
    <Key
        latin:keySpec="&#x3142;"
        latin:keyHintLabel="~"
        latin:moreKeys="~" />
    <!-- U+3148: "ㅈ" -> hint "`", popup "`" -->
    <Key
        latin:keySpec="&#x3148;"
        latin:keyHintLabel="`"
        latin:moreKeys="`" />
    <!-- U+3137: "ㄷ" -> hint "&lt;", popup "&lt;" -->
    <Key
        latin:keySpec="&#x3137;"
        latin:keyHintLabel="&lt;"
        latin:moreKeys="&lt;" />
    <!-- U+3131: "ㄱ" -> hint "&gt;", popup "&gt;" -->
    <Key
        latin:keySpec="&#x3131;"
        latin:keyHintLabel="&gt;"
        latin:moreKeys="&gt;" />
    <!-- U+3145: "ㅅ" -> hint "&amp;", popup "&amp;" -->
    <Key
        latin:keySpec="&#x3145;"
        latin:keyHintLabel="&amp;"
        latin:moreKeys="&amp;" />
    <!-- U+315B: "ㅛ" -> hint "*", popup "*" -->
    <Key
        latin:keySpec="&#x315B;"
        latin:keyHintLabel="*"
        latin:moreKeys="*" />
    <!-- U+3155: "ㅕ" -> hint "[", popup "(", "[" -->
    <Key
        latin:keySpec="&#x3155;"
        latin:keyHintLabel="["
        latin:moreKeys="(,[" />
    <!-- U+3151: "ㅑ" -> hint "]", popup ")", "]" -->
    <Key
        latin:keySpec="&#x3151;"
        latin:keyHintLabel="]"
        latin:moreKeys="),]" />
</merge>
