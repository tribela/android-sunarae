<!-- Dubeolsik row 1: ㅂㅈㄷㄱㅅㅛㅕㅑㅐㅔ (10 keys).
     Key specs use Hangul compatibility jamo (U+3131..) as unicode entities.
     Double consonants are offered as long-press popups; the noshift combiner
     also produces them via repeat-key combining rules. -->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+3142: "ㅂ" -> popup U+3143: "ㅃ" -->
    <Key
        latin:keySpec="&#x3142;"
        latin:moreKeys="&#x3143;" />
    <!-- U+3148: "ㅈ" -> popup U+3149: "ㅉ" -->
    <Key
        latin:keySpec="&#x3148;"
        latin:moreKeys="&#x3149;" />
    <!-- U+3137: "ㄷ" -> popup U+3138: "ㄸ" -->
    <Key
        latin:keySpec="&#x3137;"
        latin:moreKeys="&#x3138;" />
    <!-- U+3131: "ㄱ" -> popup U+3132: "ㄲ" -->
    <Key
        latin:keySpec="&#x3131;"
        latin:moreKeys="&#x3132;" />
    <!-- U+3145: "ㅅ" -> popup U+3146: "ㅆ" -->
    <Key
        latin:keySpec="&#x3145;"
        latin:moreKeys="&#x3146;" />
    <!-- U+315B: "ㅛ" -->
    <Key
        latin:keySpec="&#x315B;" />
    <!-- U+3155: "ㅕ" -->
    <Key
        latin:keySpec="&#x3155;" />
    <!-- U+3151: "ㅑ" -->
    <Key
        latin:keySpec="&#x3151;" />
    <!-- U+3150: "ㅐ" -->
    <Key
        latin:keySpec="&#x3150;" />
    <!-- U+3154: "ㅔ" -->
    <Key
        latin:keySpec="&#x3154;" />
</merge>
