<!-- Dubeolsik row 1: ㅂㅈㄷㄱㅅㅛㅕㅑㅐㅔ (10 keys).
     Key specs use Hangul compatibility jamo (U+3131..) as unicode entities.
     Long-press popups mirror the AOSP/Gboard English keyboard special
     characters that sit on the physical QWERTY positions (Q->1, W->2, ...,
     P->0); double consonants are offered alongside the digits, since the
     noshift combiner also produces them via repeat-key combining rules. -->

<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- U+3142: "ㅂ" -> hint "1", popup U+3143: "ㅃ", "1" -->
    <Key
        latin:keySpec="&#x3142;"
        latin:keyHintLabel="1"
        latin:moreKeys="&#x3143;,1" />
    <!-- U+3148: "ㅈ" -> hint "2", popup U+3149: "ㅉ", "2" -->
    <Key
        latin:keySpec="&#x3148;"
        latin:keyHintLabel="2"
        latin:moreKeys="&#x3149;,2" />
    <!-- U+3137: "ㄷ" -> hint "3", popup U+3138: "ㄸ", "3" -->
    <Key
        latin:keySpec="&#x3137;"
        latin:keyHintLabel="3"
        latin:moreKeys="&#x3138;,3" />
    <!-- U+3131: "ㄱ" -> hint "4", popup U+3132: "ㄲ", "4" -->
    <Key
        latin:keySpec="&#x3131;"
        latin:keyHintLabel="4"
        latin:moreKeys="&#x3132;,4" />
    <!-- U+3145: "ㅅ" -> hint "5", popup U+3146: "ㅆ", "5" -->
    <Key
        latin:keySpec="&#x3145;"
        latin:keyHintLabel="5"
        latin:moreKeys="&#x3146;,5" />
    <!-- U+315B: "ㅛ" -> hint "6", popup "6" -->
    <Key
        latin:keySpec="&#x315B;"
        latin:keyHintLabel="6"
        latin:moreKeys="6" />
    <!-- U+3155: "ㅕ" -> hint "7", popup "7" -->
    <Key
        latin:keySpec="&#x3155;"
        latin:keyHintLabel="7"
        latin:moreKeys="7" />
    <!-- U+3151: "ㅑ" -> hint "8", popup "8" -->
    <Key
        latin:keySpec="&#x3151;"
        latin:keyHintLabel="8"
        latin:moreKeys="8" />
    <!-- U+3150: "ㅐ" -> hint "9", popup "9" -->
    <Key
        latin:keySpec="&#x3150;"
        latin:keyHintLabel="9"
        latin:moreKeys="9" />
    <!-- U+3154: "ㅔ" -> hint "0", popup "0" -->
    <Key
        latin:keySpec="&#x3154;"
        latin:keyHintLabel="0"
        latin:moreKeys="0" />
</merge>
